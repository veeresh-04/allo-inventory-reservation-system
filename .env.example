# Database (Supabase / Neon / Railway)
# Get this from your Postgres provider dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Redis (Upstash)
# From Upstash console: your database -> REST API.
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Local development uses Postgres row locks by default to avoid remote Redis latency.
# Set this to "true" only when you specifically want to test Upstash locally.
ENABLE_REDIS_LOCALLY="false"

# Cron job protection
# Generate with: openssl rand -hex 32
CRON_SECRET="your-cron-secret"
